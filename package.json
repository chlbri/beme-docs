{
  "name": "@bemedev/docs",
  "version": "0.0.5",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "config": "pnpm install",
    "config:off": "pnpm run config --offline",
    "ci": "pnpm run config:off && pnpm run lint && pnpm run test && pnpm run p-q",
    "ci:admin": "pnpm run rm && pnpm run upgrade && pnpm run ci",
    "dev": "vite dev",
    "dev:host": "pnpm run dev --host",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test:coverage": "vitest run",
    "lint": "pnpm run fmt && pnpm run lint:fix",
    "lint:fix": "oxlint --fix",
    "lint:watch": "onchange --await-write-finish 5500 -d 50000 -v \"**/*.ts\" -- pnpm run lint",
    "prepare": "husky",
    "pretest": "pnpm run build",
    "preview": "pnpm run build && vite start",
    "p-q": "pretty-quick",
    "rinit": "pnpm run rm && pnpm run config",
    "rinit:off": "pnpm run rm && pnpm run config:off",
    "rm": "pnpx rimraf ./node_modules ./pnpm-lock.yaml",
    "rollup": "rollup -c",
    "start": "vite start",
    "test": "pnpm run test:coverage --no-coverage",
    "test:only": "pnpm run test:coverage --no-coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "upgrade": "pnpm up --latest"
  },
  "dependencies": {
    "@bemedev/app-ts": "^2.0.0",
    "@bemedev/decompose": "^2.0.3",
    "@bemedev/fsf": "^1.0.1",
    "@bemedev/i18n": "^0.5.2",
    "@bemedev/pipe": "^0.1.0",
    "@bemedev/sleep": "^0.2.2",
    "@kobalte/core": "^0.13.11",
    "@solid-primitives/intersection-observer": "^2.2.4",
    "@solid-primitives/storage": "^4.3.4",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/pacer-lite": "^0.2.1",
    "@tanstack/solid-pacer": "^0.19.0",
    "@tanstack/solid-router": "1.167.5",
    "@tanstack/solid-start": "1.166.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "color": "^5.0.3",
    "lucide-solid": "^0.577.0",
    "nitro": "3.0.260311-beta",
    "redaxios": "^0.5.1",
    "solid-js": "^1.9.11",
    "solid-motionone": "^1.0.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.3.1",
    "vinxi": "0.5.11",
    "vite": "^8.0.1"
  },
  "devDependencies": {
    "@bemedev/app-cli": "^0.1.7",
    "@bemedev/build-tests": "^0.1.2",
    "@bemedev/rollup-config": "^0.2.2",
    "@bemedev/vitest-alias": "^0.0.3",
    "@bemedev/vitest-exclude": "^0.1.1",
    "@bemedev/vitest-extended": "^1.5.3",
    "@content-collections/core": "^0.14.2",
    "@content-collections/markdown": "^0.1.4",
    "@content-collections/vite": "^0.2.9",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tanstack/solid-router-devtools": "1.166.9",
    "@toolwind/corner-shape": "0.0.8-3",
    "@types/clone-deep": "^4.0.4",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/browser-playwright": "4.1.0",
    "@vitest/coverage-istanbul": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "combinate": "^1.1.11",
    "eslint": "^10.0.3",
    "glob": "^13.0.6",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "onchange": "^7.1.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "playwright": "^1.58.2",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-plugin-solid": "^2.11.11",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.0"
  }
}
